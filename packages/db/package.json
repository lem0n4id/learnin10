{
  "name": "@learnin10/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./drizzle.config.ts",
    "db:push": "drizzle-kit push --config ./drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,css,md,json}\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "next": "^14.2.35",
    "server-only": "^0.0.1",
    "zod": "^3.23.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.21.4"
  }
}
